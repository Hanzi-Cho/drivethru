{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hanzi-cho.dev/drivethru/order.schema.json",
  "title": "DriveThru Order Option Catalog",
  "type": "object",
  "required": ["storeId", "optionGroups"],
  "properties": {
    "storeId": { "type": "string" },
    "optionGroups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "choices"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "required": { "type": "boolean" },
          "minSelections": { "type": "integer" },
          "maxSelections": { "type": "integer" },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "label", "priceDelta"],
              "properties": {
                "id": { "type": "string" },
                "label": { "type": "string" },
                "priceDelta": { "type": "integer" },
                "imageUrl": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
